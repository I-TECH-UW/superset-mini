# =============================================================================
# ALERTS AND REPORTS ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy these variables to your docker/.env file and customize the values
# according to your setup. Uncomment and modify the lines you need.

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# Uncomment and configure these for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=True
# SMTP_SSL_SERVER_AUTH=False
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_MAIL_FROM=your-email@gmail.com

# =============================================================================
# SLACK CONFIGURATION
# =============================================================================
# Uncomment and configure for Slack notifications
# SLACK_API_TOKEN=xoxb-your-slack-bot-token-here
# SLACK_PROXY=

# =============================================================================
# WEBDRIVER CONFIGURATION
# =============================================================================
# WebDriver type for report screenshots (chrome or firefox)
# WEBDRIVER_TYPE=chrome

# =============================================================================
# ALERTS AND REPORTS SETTINGS
# =============================================================================
# Set to False to enable actual notifications (default is True for safety)
# ALERT_REPORTS_NOTIFICATION_DRY_RUN=False

# =============================================================================
# EXAMPLE CONFIGURATIONS FOR COMMON EMAIL PROVIDERS
# =============================================================================

# Gmail SMTP Configuration:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=True
# SMTP_SSL_SERVER_AUTH=False
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=your-app-password  # Use App Password, not regular password
# SMTP_MAIL_FROM=your-gmail@gmail.com

# Outlook/Hotmail SMTP Configuration:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_STARTTLS=True
# SMTP_SSL_SERVER_AUTH=False
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-password
# SMTP_MAIL_FROM=your-email@outlook.com

# Amazon SES SMTP Configuration:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_STARTTLS=True
# SMTP_SSL_SERVER_AUTH=False
# SMTP_USER=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
# SMTP_MAIL_FROM=noreply@yourdomain.com

# SendGrid SMTP Configuration:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_STARTTLS=True
# SMTP_SSL_SERVER_AUTH=False
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_MAIL_FROM=noreply@yourdomain.com
